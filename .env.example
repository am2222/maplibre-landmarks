# One of these is required for the demo basemap (not for e2e.html).
# Free key: https://protomaps.com/account
VITE_PROTOMAPS_KEY=
# Or your own archive, e.g. https://example.com/planet.pmtiles
VITE_PMTILES_URL=
# Optional: an Overture-schema building tileset with roof attributes
# (scripts/buildings/overture-to-pmtiles.sh), drawn with real roof shapes.
VITE_ROOFS_PMTILES=
