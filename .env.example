# One of these is required for the demo basemap (not for e2e.html).
# Free key: https://protomaps.com/account
VITE_PROTOMAPS_KEY=
# Or your own archive, e.g. https://example.com/planet.pmtiles
VITE_PMTILES_URL=
# Optional: your own Overture-schema building tileset (one `building` layer, feature ids),
# shown with the demo's "Roof data: Local file" option. By default the demo uses Overture's
# official tiles.
VITE_ROOFS_PMTILES=
