{
  "name": "maplibre-landmarks",
  "version": "0.1.0",
  "description": "Open Landmarks 3D models for MapLibre GL JS, rendered with Three.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/am2222/maplibre-landmarks.git"
  },
  "homepage": "https://am2222.github.io/maplibre-landmarks/",
  "bugs": {
    "url": "https://github.com/am2222/maplibre-landmarks/issues"
  },
  "keywords": [
    "maplibre",
    "maplibre-gl",
    "threejs",
    "three",
    "3d",
    "landmarks",
    "buildings",
    "roofs",
    "trees",
    "fog",
    "water"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "module": "./dist/maplibre-landmarks.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/maplibre-landmarks.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "lint": "eslint . && prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && DEMO_SITE=1 vite build --config demo/vite.config.ts",
    "docs:preview": "vitepress preview docs",
    "docs:check": "node scripts/check-site.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "maplibre-gl": ">=6.13.0",
    "three": ">=0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@protomaps/basemaps": "^5.7.2",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "maplibre-gl": "^6.13.0",
    "pmtiles": "^4.5.0",
    "prettier": "^3.9.9",
    "three": "^0.186.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7"
  }
}
